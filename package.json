{
  "name": "spruce_apartments-3d",
  "version": "1.0.0",
  "description": "Walkable, to-scale Three.js model of a one-bedroom apartment with furniture planning and iPhone AR",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shot": "node tools/shot.mjs",
    "dev:phone": "vite --host --port 5183",
    "export:ar": "node tools/export-ar.mjs",
    "deploy": "vite build && rsync -az --delete dist/ ${DEPLOY_TARGET:-hetzner-user:/var/www/apartment/}"
  },
  "keywords": [],
  "author": "Sreenivasan AC",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  },
  "type": "module",
  "private": true
}
